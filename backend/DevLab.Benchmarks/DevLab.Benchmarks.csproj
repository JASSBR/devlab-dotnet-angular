<Project Sdk="Microsoft.NET.Sdk">
  <!-- Run in Release only (see Program.cs for the command line): BenchmarkDotNet refuses Debug builds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- BDN rebuilds this project in a generated sibling project: never ship it, never test it. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
</Project>
