<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- TargetFramework, Nullable, warnings policy… come from ../Directory.Build.props -->
  <PropertyGroup>
    <!-- AV0029 is triaged in .editorconfig, but it also fires inside the OpenAPI source generator's
         output, which .editorconfig sections never match. -->
    <NoWarn>$(NoWarn);AV0029</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
</Project>
