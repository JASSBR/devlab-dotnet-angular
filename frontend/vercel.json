{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://devlab-api.thankfulsky-d03b7a33.italynorth.azurecontainerapps.io/api/:path*"
    },
    {
      "source": "/idp/:path*",
      "destination": "https://devlab-api.thankfulsky-d03b7a33.italynorth.azurecontainerapps.io/idp/:path*"
    },
    {
      "source": "/((?!api/|idp/|hubs/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/source-snapshot.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
